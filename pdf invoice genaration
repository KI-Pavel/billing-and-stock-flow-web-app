import re

receipt_text = """
Store: XYZ Superstore
Date: 2025-08-10
--------------------------------
Item                Qty    Price
Toothpaste          1      2.50
Brush               2      1.20
Plastic Bottle      3      0.80
--------------------------------
Total:              7.30
"""

pattern = r"([A-Za-z\s]+?)\s+(\d+)\s+(\d+\.\d{2})"

items = []
for match in re.finditer(pattern, receipt_text):
    item_name, qty, price = match.groups()
    items.append({
        "item": item_name.strip(),
        "quantity": int(qty),
        "price_per_unit": float(price)
    })

total_match = re.search(r"Total:\s+(\d+\.\d{2})", receipt_text)
total_amount = float(total_match.group(1)) if total_match else None


print("Extracted Items:")
for item in items:
    print(f"{item['item']} - Qty: {item['quantity']}, Price per unit: {item['price_per_unit']}")

print(f"\nTotal Amount: {total_amount}")

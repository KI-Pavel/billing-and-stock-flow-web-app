<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Payment Form</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: Arial, sans-serif;
    }

    body {
      background-color: #f4f4f9;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .payment-container {
      background-color: #fff;
      padding: 30px 40px;
      border-radius: 15px;
      box-shadow: 0 8px 20px rgba(0,0,0,0.1);
      width: 400px;
    }

    .payment-container h2 {
      text-align: center;
      margin-bottom: 25px;
      color: #333;
    }

    .payment-container form {
      display: flex;
      flex-direction: column;
    }

    .payment-container input[type="text"],
    .payment-container input[type="email"],
    .payment-container input[type="number"] {
      padding: 12px;
      margin-bottom: 20px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    .payment-container input[type="submit"] {
      padding: 12px;
      background-color: #4CAF50;
      border: none;
      border-radius: 8px;
      color: #fff;
      font-size: 18px;
      cursor: pointer;
      transition: background-color 0.3s ease;
    }

    .payment-container input[type="submit"]:hover {
      background-color: #45a049;
    }

    .card-info {
      display: flex;
      justify-content: space-between;
    }

    .card-info input {
      width: 48%;
    }
  </style>
</head>
<body>
  <div class="payment-container">
    <h2>Payment Form</h2>
    <form action="#" method="POST">
      <input type="text" name="name" placeholder="Full Name" required>
      <input type="email" name="email" placeholder="Email Address" required>
      <div class="card-info">
        <input type="text" name="card-number" placeholder="Card Number" required>
        <input type="text" name="cvv" placeholder="CVV" required>
      </div>
      <div class="card-info">
        <input type="text" name="expiry" placeholder="Expiry MM/YY" required>
        <input type="number" name="amount" placeholder="Amount" required>
      </div>
      <input type="submit" value="Pay Now">
    </form>
  </div>
</body>
</html>
